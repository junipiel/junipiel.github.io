<div class="sketch" data-contact-configuration>
  <div class="sketch__header">
    <span>Rigid equal-sphere cluster</span>
    <span class="sketch__math">‖xᵢ − xⱼ‖ = 2r</span>
  </div>
  <canvas
    class="sketch__canvas"
    aria-label="An exact octahedral contact graph and its realization by six equal spheres. Drag to rotate, or use the arrow keys."
    tabindex="0"
  >
    An exact octahedral contact graph and its realization by six equal spheres.
  </canvas>
  <div class="sketch__footer sketch__footer--controls">
    <label class="sketch__mode">
      <span>Contact graph</span>
      <input type="range" min="0" max="100" value="0" aria-label="Blend between contact graph and sphere realization" />
      <span>Realization</span>
    </label>
    <span class="sketch__count">N = 6 · |E| = 12</span>
  </div>
</div>

<script>
  type Point3 = [number, number, number];

  interface ProjectedPoint {
    x: number;
    y: number;
    z: number;
    index: number;
  }

  interface Contact {
    from: number;
    to: number;
    depth: number;
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-contact-configuration]').forEach((sketch) => {
    const canvas = sketch.querySelector<HTMLCanvasElement>('canvas');
    const slider = sketch.querySelector<HTMLInputElement>('input[type="range"]');
    const context = canvas?.getContext('2d');

    if (!canvas || !slider || !context) return;

    // Six unit spheres at the vertices of a regular octahedron.
    // Every non-antipodal pair of centres is exactly distance 2 apart.
    const root = Math.SQRT2;
    const points: Point3[] = [
      [root, 0, 0],
      [-root, 0, 0],
      [0, root, 0],
      [0, -root, 0],
      [0, 0, root],
      [0, 0, -root],
    ];

    const contacts = points.flatMap((from, fromIndex) =>
      points.slice(fromIndex + 1).flatMap((to, offset) => {
        const toIndex = fromIndex + offset + 1;
        const distance = Math.hypot(from[0] - to[0], from[1] - to[1], from[2] - to[2]);
        return Math.abs(distance - 2) < 1e-12 ? [{ from: fromIndex, to: toIndex, depth: 0 }] : [];
      }),
    );

    const startedAt = performance.now();
    let width = 0;
    let height = 0;
    let animationFrame = 0;
    let yaw = -0.72;
    let pitch = -0.38;
    let velocityYaw = 0;
    let velocityPitch = 0;
    let lastPointerX = 0;
    let lastPointerY = 0;
    let isDragging = false;
    let hoveredSphere = -1;
    let projected: ProjectedPoint[] = [];
    let currentMix = 0;
    let manualUntil = 0;

    const smoothStep = (value: number) => value * value * (3 - 2 * value);

    const automaticMix = (time: number) => {
      const phase = ((time - startedAt) % 18000) / 18000;

      if (phase < 0.16) return 0;
      if (phase < 0.42) return smoothStep((phase - 0.16) / 0.26);
      if (phase < 0.66) return 1;
      if (phase < 0.92) return 1 - smoothStep((phase - 0.66) / 0.26);
      return 0;
    };

    const rotate = ([x, y, z]: Point3): Point3 => {
      const cosYaw = Math.cos(yaw);
      const sinYaw = Math.sin(yaw);
      const cosPitch = Math.cos(pitch);
      const sinPitch = Math.sin(pitch);

      const yawX = x * cosYaw - z * sinYaw;
      const yawZ = x * sinYaw + z * cosYaw;

      return [yawX, y * cosPitch - yawZ * sinPitch, y * sinPitch + yawZ * cosPitch];
    };

    const project = (point: Point3, index: number, scale: number): ProjectedPoint => {
      const rotated = rotate(point);

      return {
        x: width * 0.5 + rotated[0] * scale,
        y: height * 0.5 + rotated[1] * scale,
        z: rotated[2],
        index,
      };
    };

    const drawBackground = () => {
      const radius = Math.min(width, height) * 0.36;

      context.save();
      context.translate(width * 0.5, height * 0.5);
      context.rotate(-0.13);
      context.setLineDash([2, 8]);
      context.lineWidth = 1;
      context.strokeStyle = 'rgba(238, 242, 233, 0.09)';
      context.beginPath();
      context.ellipse(0, 0, radius, radius * 0.34, 0, 0, Math.PI * 2);
      context.stroke();
      context.restore();
      context.setLineDash([]);
    };

    const draw = (time = performance.now()) => {
      if (!reduceMotion.matches && !isDragging) {
        yaw += 0.0017 + velocityYaw;
        pitch += velocityPitch;
        velocityYaw *= 0.92;
        velocityPitch *= 0.88;
      }

      if (reduceMotion.matches) {
        currentMix = 1;
      } else if (time >= manualUntil) {
        currentMix = automaticMix(time);
        slider.value = String(Math.round(currentMix * 100));
      } else {
        currentMix = Number(slider.value) / 100;
      }

      context.clearRect(0, 0, width, height);
      drawBackground();

      const scale = Math.min(width, height) * 0.19;
      projected = points.map((point, index) => project(point, index, scale));
      const nodeRadius = Math.min(width, height) * 0.017;
      // At currentMix = 1, this is the same scale used for a unit
      // displacement in the centre coordinates above.
      const sphereRadius = nodeRadius + (scale - nodeRadius) * currentMix;
      const sortedContacts: Contact[] = contacts
        .map((contact) => ({
          ...contact,
          depth: (projected[contact.from].z + projected[contact.to].z) * 0.5,
        }))
        .sort((a, b) => a.depth - b.depth);

      context.lineCap = 'round';
      sortedContacts.forEach((contact) => {
        const from = projected[contact.from];
        const to = projected[contact.to];
        const active = hoveredSphere === contact.from || hoveredSphere === contact.to;

        context.beginPath();
        context.moveTo(from.x, from.y);
        context.lineTo(to.x, to.y);
        context.lineWidth = active ? 2.25 : 0.9 + (1 - currentMix) * 0.8;
        context.strokeStyle = active
          ? 'rgba(239, 128, 101, 0.92)'
          : `rgba(238, 242, 233, ${0.08 + (1 - currentMix) * 0.62})`;
        context.stroke();
      });

      [...projected]
        .sort((a, b) => a.z - b.z)
        .forEach((point) => {
          const active = point.index === hoveredSphere;
          const lightX = point.x - sphereRadius * 0.34;
          const lightY = point.y - sphereRadius * 0.38;
          const gradient = context.createRadialGradient(
            lightX,
            lightY,
            sphereRadius * 0.06,
            point.x,
            point.y,
            sphereRadius,
          );

          if (active) {
            gradient.addColorStop(0, '#ffd9ca');
            gradient.addColorStop(0.58, '#ef8065');
            gradient.addColorStop(1, '#9b3d2c');
          } else {
            gradient.addColorStop(0, '#ffffff');
            gradient.addColorStop(0.52, '#e4eee6');
            gradient.addColorStop(1, '#8ba397');
          }

          context.beginPath();
          context.arc(point.x, point.y, sphereRadius, 0, Math.PI * 2);
          context.fillStyle = gradient;
          context.fill();
          context.lineWidth = active ? 2 : 0.8;
          context.strokeStyle = active ? '#ffd5c7' : 'rgba(238, 242, 233, 0.42)';
          context.stroke();
        });

      if (!reduceMotion.matches) animationFrame = requestAnimationFrame(draw);
    };

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = bounds.width;
      height = bounds.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      cancelAnimationFrame(animationFrame);
      draw();
    };

    const sphereAt = (x: number, y: number) =>
      [...projected]
        .sort((a, b) => b.z - a.z)
        .find(
          (point) =>
            Math.hypot(x - point.x, y - point.y) <=
            Math.max(12, Math.min(width, height) * 0.19 * currentMix),
        )?.index ?? -1;

    const startDrag = (event: PointerEvent) => {
      isDragging = true;
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      velocityYaw = 0;
      velocityPitch = 0;
      canvas.setPointerCapture(event.pointerId);
      sketch.classList.add('is-dragging');
    };

    const updatePointer = (event: PointerEvent) => {
      const bounds = canvas.getBoundingClientRect();

      if (isDragging) {
        const deltaX = event.clientX - lastPointerX;
        const deltaY = event.clientY - lastPointerY;
        yaw += deltaX * 0.0085;
        pitch = Math.max(-1.25, Math.min(1.25, pitch + deltaY * 0.0085));
        velocityYaw = deltaX * 0.0011;
        velocityPitch = deltaY * 0.0009;
        lastPointerX = event.clientX;
        lastPointerY = event.clientY;
        hoveredSphere = -1;
      } else {
        hoveredSphere = sphereAt(event.clientX - bounds.left, event.clientY - bounds.top);
      }

      if (reduceMotion.matches) draw();
    };

    const endDrag = (event: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
      sketch.classList.remove('is-dragging');
    };

    const restartAnimation = () => {
      cancelAnimationFrame(animationFrame);
      draw();
    };

    canvas.addEventListener('pointerdown', startDrag);
    canvas.addEventListener('pointermove', updatePointer);
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);
    canvas.addEventListener('pointerleave', () => {
      if (!isDragging) hoveredSphere = -1;
    });
    canvas.addEventListener('keydown', (event) => {
      const step = 0.1;
      if (event.key === 'ArrowLeft') yaw -= step;
      else if (event.key === 'ArrowRight') yaw += step;
      else if (event.key === 'ArrowUp') pitch = Math.max(-1.25, pitch - step);
      else if (event.key === 'ArrowDown') pitch = Math.min(1.25, pitch + step);
      else return;
      event.preventDefault();
      if (reduceMotion.matches) draw();
    });
    slider.addEventListener('input', () => {
      manualUntil = performance.now() + 10000;
      currentMix = Number(slider.value) / 100;
      if (reduceMotion.matches) draw();
    });
    reduceMotion.addEventListener('change', restartAnimation);

    const observer = new ResizeObserver(resize);
    observer.observe(canvas);
  });
</script>
