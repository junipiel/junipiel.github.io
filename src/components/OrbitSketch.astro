<div class="sketch" data-orbit-sketch>
  <div class="sketch__header">
    <span>Small experiment</span>
    <span class="sketch__hint">Move your pointer</span>
  </div>
  <canvas class="sketch__canvas" aria-hidden="true"></canvas>
  <div class="sketch__footer">
    <span>01</span>
    <span>Ideas in motion</span>
  </div>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-orbit-sketch]').forEach((sketch) => {
    const canvas = sketch.querySelector<HTMLCanvasElement>('canvas');
    const context = canvas?.getContext('2d');

    if (!canvas || !context) return;

    let width = 0;
    let height = 0;
    let frame = 0;
    let animationFrame = 0;

    const pointer = {
      x: 0.62,
      y: 0.44,
      active: false,
    };

    const particles = Array.from({ length: 46 }, (_, index) => ({
      angle: (index / 46) * Math.PI * 2,
      radius: 0.17 + ((index * 29) % 73) / 100,
      speed: 0.18 + ((index * 11) % 17) / 100,
      size: index % 9 === 0 ? 2.4 : 1.15,
    }));

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = bounds.width;
      height = bounds.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw();
    };

    const drawGrid = () => {
      context.strokeStyle = 'rgba(238, 242, 233, 0.09)';
      context.lineWidth = 1;

      for (let x = 28; x < width; x += 28) {
        context.beginPath();
        context.moveTo(x, 0);
        context.lineTo(x, height);
        context.stroke();
      }

      for (let y = 28; y < height; y += 28) {
        context.beginPath();
        context.moveTo(0, y);
        context.lineTo(width, y);
        context.stroke();
      }
    };

    const draw = () => {
      const time = frame / 60;
      context.clearRect(0, 0, width, height);
      drawGrid();

      const driftX = reduceMotion.matches ? 0 : Math.sin(time * 0.34) * 0.035;
      const driftY = reduceMotion.matches ? 0 : Math.cos(time * 0.27) * 0.035;
      const centerX = (pointer.active ? pointer.x : 0.59 + driftX) * width;
      const centerY = (pointer.active ? pointer.y : 0.48 + driftY) * height;
      const scale = Math.min(width, height) * 0.38;

      context.strokeStyle = 'rgba(238, 242, 233, 0.24)';
      context.lineWidth = 1;

      for (let orbit = 0; orbit < 3; orbit += 1) {
        context.beginPath();
        context.ellipse(
          centerX,
          centerY,
          scale * (0.42 + orbit * 0.26),
          scale * (0.19 + orbit * 0.11),
          -0.48 + orbit * 0.28,
          0,
          Math.PI * 2,
        );
        context.stroke();
      }

      particles.forEach((particle, index) => {
        const angle = particle.angle + time * particle.speed;
        const ring = 0.36 + (index % 3) * 0.23;
        const x = centerX + Math.cos(angle) * scale * ring;
        const y = centerY + Math.sin(angle * 1.37) * scale * ring * 0.48;

        context.beginPath();
        context.fillStyle = index % 11 === 0 ? '#ef8065' : 'rgba(238, 242, 233, 0.78)';
        context.arc(x, y, particle.size, 0, Math.PI * 2);
        context.fill();
      });

      context.beginPath();
      context.fillStyle = '#ef8065';
      context.arc(centerX, centerY, 4.5, 0, Math.PI * 2);
      context.fill();

      if (!reduceMotion.matches) {
        frame += 1;
        animationFrame = requestAnimationFrame(draw);
      }
    };

    const updatePointer = (event: PointerEvent) => {
      const bounds = canvas.getBoundingClientRect();
      pointer.x = (event.clientX - bounds.left) / bounds.width;
      pointer.y = (event.clientY - bounds.top) / bounds.height;
      pointer.active = true;
    };

    const releasePointer = () => {
      pointer.active = false;
    };

    const restartAnimation = () => {
      cancelAnimationFrame(animationFrame);
      draw();
    };

    canvas.addEventListener('pointermove', updatePointer);
    canvas.addEventListener('pointerleave', releasePointer);
    reduceMotion.addEventListener('change', restartAnimation);

    const observer = new ResizeObserver(resize);
    observer.observe(canvas);
  });
</script>
