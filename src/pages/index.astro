---
import BaseLayout from '../layouts/BaseLayout.astro';
import HopfFibration from '../components/HopfFibration.astro';

const year = new Date().getFullYear();
const description =
  'Julian Pielmaier — currently working on a master’s thesis at the Max Planck Institute for Mathematics in the Sciences.';
---

<BaseLayout title="Julian Pielmaier — junipiel" description={description}>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <a class="wordmark" href="/" aria-label="junipiel home">
      <span class="wordmark__mark" aria-hidden="true">j</span>
      <span>junipiel</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="#current">Current</a>
      <a href="https://github.com/junipiel" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <h1 id="hero-title">Hi, I’m Julian.</h1>
        <p class="hero__text hero__text--primary">
          I’m currently working on my master’s thesis at the Max Planck Institute for Mathematics in the
          Sciences in Leipzig.
        </p>
        <p class="hero__text">
          I’m interested in mathematics, code, and small interactive experiments that make abstract ideas
          easier to explore.
        </p>

        <div class="wip-note">
          <span class="wip-note__label">Work in progress</span>
          <p>
            This site is still taking shape. I want it to become a place for research notes, projects, and
            interactive things I build along the way.
          </p>
        </div>

        <div class="hero__actions">
          <a class="button button--primary" href="https://github.com/junipiel" rel="me noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--quiet" href="https://www.mis.mpg.de/" rel="noreferrer">
            MPI MiS <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero__visual">
        <HopfFibration />
      </div>
    </section>

    <section class="section" id="current" aria-labelledby="current-title">
      <div class="section__label" aria-hidden="true">01 / Now</div>
      <div class="section__content">
        <h2 id="current-title">What I’m working on</h2>

        <div class="facts">
          <div class="fact">
            <span class="fact__label">Current project</span>
            <span>Master’s thesis</span>
          </div>
          <div class="fact">
            <span class="fact__label">Institution</span>
            <a href="https://www.mis.mpg.de/" rel="noreferrer">
              Max Planck Institute for Mathematics in the Sciences <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="fact">
            <span class="fact__label">Location</span>
            <span>Leipzig, Germany</span>
          </div>
          <div class="fact">
            <span class="fact__label">Details</span>
            <span>Work in progress</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="direction-title">
      <div class="section__label" aria-hidden="true">02 / This site</div>
      <div class="section__content">
        <h2 id="direction-title">Where this is heading</h2>
        <p class="section__lead">
          I’d like this page to become a small, informal record of what I’m learning and building. These are
          the parts I plan to add next.
        </p>

        <ul class="roadmap">
          <li>
            <span class="roadmap__title">Research notes</span>
            <span>Background, references, and notes related to my work.</span>
            <span class="roadmap__status">In progress</span>
          </li>
          <li>
            <span class="roadmap__title">Code & projects</span>
            <span>Selected repositories with a little more context than a README.</span>
            <span class="roadmap__status">In progress</span>
          </li>
          <li>
            <span class="roadmap__title">Mathematical demos</span>
            <span>Small interactive ways to explore geometric and mathematical ideas.</span>
            <span class="roadmap__status">In progress</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--last" aria-labelledby="elsewhere-title">
      <div class="section__label" aria-hidden="true">03 / Links</div>
      <div class="section__content">
        <h2 id="elsewhere-title">Links</h2>
        <a class="large-link" href="https://github.com/junipiel" rel="me noreferrer">
          <span>GitHub</span>
          <span class="large-link__handle">@junipiel</span>
          <span class="large-link__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>© {year} Julian Pielmaier</span>
    <span>junipiel.com</span>
  </footer>
</BaseLayout>
