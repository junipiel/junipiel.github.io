---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactConfiguration from '../components/ContactConfiguration.astro';

const year = new Date().getFullYear();
const description =
  'Personal website of Julian Pielmaier: computer science, machine learning, graphs, time series, and current research.';
---

<BaseLayout title="Julian Pielmaier | junipiel" description={description}>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <a class="wordmark" href="/" aria-label="junipiel home">
      <span class="wordmark__mark" aria-hidden="true">j</span>
      <span>junipiel</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="#current">Now</a>
      <a href="#interests">Interests</a>
      <a href="https://github.com/junipiel" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <h1 id="hero-title">Hi, I’m Julian.</h1>
        <p class="hero__text hero__text--primary">
          I study computer science and work on machine learning. I started out mostly on the engineering side,
          building systems and pipelines. Over time, I became more interested in the research questions behind
          them: why a method works, what information it uses, and where it fails.
        </p>
        <p class="hero__text">
          I’m especially interested in graphs, time series, geometric deep learning, and methods that combine
          learning with classical algorithms.
        </p>

        <div class="wip-note">
          <span class="wip-note__label">Work in progress</span>
          <p>
            This is an early version of my site. I plan to add project pages, notes, and a few interactive
            examples. Some sections are still missing.
          </p>
        </div>

        <div class="hero__actions">
          <a class="button button--primary" href="https://github.com/junipiel" rel="me noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--quiet" href="#current">
            Current work <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="hero__visual">
        <ContactConfiguration />
      </div>
    </section>

    <section class="section" id="current" aria-labelledby="current-title">
      <div class="section__label" aria-hidden="true">01 / Now</div>
      <div class="section__content">
        <h2 id="current-title">What I’m working on</h2>
        <p class="section__lead">
          Right now, I am working on my master’s thesis and, in parallel, as a research assistant at InfAI.
        </p>

        <div class="work-list">
          <article class="work-item">
            <div class="work-item__meta">Master’s thesis · ongoing</div>
            <h3>Rigid sphere packings from contact graphs</h3>
            <p>
              My thesis uses the rigid equal-sphere clusters enumerated by Miranda Holmes-Cerfon. Starting from
              a contact graph, I look for a valid three-dimensional realization and compare classical methods
              with learned models that provide initializations for a local solver. I want to understand what
              geometric information the models learn and when they improve on strong classical baselines.
            </p>
            <p class="work-item__context">
              I am working on the thesis as a visiting researcher at the Max Planck Institute for Mathematics
              in the Sciences in Leipzig.
            </p>
          </article>

          <article class="work-item work-item--compact">
            <div class="work-item__meta">Research assistant · ongoing</div>
            <h3>Project KORALLE</h3>
            <p>
              Alongside my thesis, I work as a research assistant at InfAI on the KORALLE project.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="interests" aria-labelledby="interests-title">
      <div class="section__label" aria-hidden="true">02 / Interests</div>
      <div class="section__content">
        <h2 id="interests-title">What I’m interested in</h2>
        <p class="section__lead">
          Most of my work involves structured data. I want to understand how relationships and temporal
          patterns can be represented, and what models can learn from them.
        </p>

        <ul class="threads">
          <li>
            <span class="threads__title">Graphs and geometry</span>
            <span>Graph representations, rigid structures, and geometric deep learning.</span>
          </li>
          <li>
            <span class="threads__title">Time series</span>
            <span>Temporal and streaming data, including anomaly detection.</span>
          </li>
          <li>
            <span class="threads__title">Machine learning</span>
            <span>Learning for structured problems and hybrid methods with classical solvers.</span>
          </li>
          <li>
            <span class="threads__title">Model understanding</span>
            <span>Why a model works, what it has learned, and when it fails.</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="direction-title">
      <div class="section__label" aria-hidden="true">03 / This site</div>
      <div class="section__content">
        <h2 id="direction-title">This site is still in progress</h2>
        <p class="section__lead">
          I want to use it to document my work properly, with enough context to understand the problem, the
          method, and the parts that did not work.
        </p>

        <ul class="roadmap">
          <li>
            <span class="roadmap__title">Projects</span>
            <span>Longer pages for selected work.</span>
            <span class="roadmap__status">In progress</span>
          </li>
          <li>
            <span class="roadmap__title">Notes</span>
            <span>Short notes on topics I am learning or using.</span>
            <span class="roadmap__status">In progress</span>
          </li>
          <li>
            <span class="roadmap__title">Interactive examples</span>
            <span>Small demos where they help explain something.</span>
            <span class="roadmap__status">In progress</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--last" aria-labelledby="elsewhere-title">
      <div class="section__label" aria-hidden="true">04 / Links</div>
      <div class="section__content">
        <h2 id="elsewhere-title">Links</h2>
        <a class="large-link" href="https://github.com/junipiel" rel="me noreferrer">
          <span>GitHub</span>
          <span class="large-link__handle">@junipiel</span>
          <span class="large-link__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>© {year} Julian Pielmaier</span>
    <span>junipiel.com</span>
  </footer>
</BaseLayout>
